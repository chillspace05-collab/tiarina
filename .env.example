TELEGRAM_BOT_TOKEN=isi_dari_BotFather
OWNER_CHAT_ID=

# Gemini (dipakai juga untuk cari web dan gambar)
GEMINI_API_KEY=isi_dari_Google_AI_Studio

# Model Tiarina Cloud (AI Services). Endpoint dari halaman Overview.
LLM_BASE_URL=https://ai.tiarina.cloud/v1
LLM_API_KEY=isi_key_sk-tiar_dari_API_KEYS
LLM_PROVIDER=tiarina

# TokenomixAI (API kompatibel OpenAI). Jadikan utama dengan LLM_PROVIDER=tokenomix
# TOKENOMIX_API_KEY=isi_key_sk-tkx
# TOKENOMIX_BASE_URL=https://api.tokenomixai.com/v1
# TOKENOMIX_MODEL=deepseek-v4.1-flash,glm-5.3-flash,mimo-v2.6-flash

# Opsional - kosongkan untuk memakai daftar bawaan. Bisa diisi beberapa model dipisah koma;
# bot otomatis pindah ke model berikutnya jika model sibuk / kena rate limit.
# LLM_MODEL=deepseek-v4.1-flash:free,deepseek-v4-flash:free,qwen3.8-flash:free,glm-5.3-flash:free,deepseek-v4.1-flash-netra:free
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# IMAGE_MODEL=gemini-3.1-flash-image,gemini-3.1-flash-lite-image
# IMAGES_PER_DAY=20
# TIMEOUT_MS=45000
# SYSTEM_PROMPT_EXTRA=Tambahan kepribadian atau aturan untuk agent

# ---- Threads (posting teks harian) ----
# THREADS_ACCESS_TOKEN=token_long_lived_dari_Meta
# THREADS_USER_ID=me
# THREADS_APP_SECRET=app_secret_dari_Meta   (opsional: agar token 1 jam otomatis ditukar jadi 60 hari)
# THREADS_JADWAL=19:00
# THREADS_MODE=setuju        (setuju = draf dikirim dulu ke Telegram; otomatis = langsung posting)
# THREADS_TOPIK=acak         (acak, nomor 1-6, atau teks bebas)
# THREADS_PANJANG=1          (1-4 bagian per postingan)
# THREADS_PERSONA=...        (siapa penulisnya; sesuaikan dengan dirimu)
# THREADS_GAYA=...           (gaya bahasa)

# Batas tunggu model utama (ms). Lewat dari ini, bot pindah ke penyedia cadangan.
# SLOW_MS=25000
